# Debug profile to simulate development-oriented embedded builds.
BR2_TARGET_GENERIC_HOSTNAME="daemon-br-debug"
BR2_TARGET_GENERIC_ISSUE="daemon-util buildroot debug"
BR2_ENABLE_DEBUG=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_LOCALOPTIONS="-w"
BR2_PACKAGE_STRACE=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_CPIO=y
