# Release profile for a leaner production-style footprint.
BR2_TARGET_GENERIC_HOSTNAME="daemon-br-release"
BR2_TARGET_GENERIC_ISSUE="daemon-util buildroot release"
BR2_ENABLE_RUNTIME_DEBUG=n
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_LOCALOPTIONS="-w"
BR2_OPTIMIZE_2=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
